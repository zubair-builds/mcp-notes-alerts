# Postgres connection string (Neon, Supabase, or any Postgres works)
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# Password used to log into /dashboard and manage API keys.
# Pick something long and random -- this is the only thing standing
# between the public internet and your API key management UI.
DASHBOARD_PASSWORD="change-me"

# Random secret used to sign the dashboard session cookie.
# Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-too"

# Shared secret Vercel Cron sends when it calls /api/cron/evaluate-alerts.
# Set the same value in vercel.json / the Vercel Cron config.
CRON_SECRET="change-me-as-well"
